{
  "name": "baharmaz-online-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --conditions=react-server --test tests/*.test.mjs",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "db:config:check": "node --conditions=react-server --env-file-if-exists=.env.local scripts/check-database-config.mjs",
    "test:database": "node tests/integration/database-smoke.mjs",
    "test:integration": "npm run test:database",
    "test:backup-restore": "node tests/integration/backup-restore.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:foundation": "node scripts/test-foundation.mjs",
    "admin:bootstrap": "node --conditions=react-server --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "db:identity:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/identity-indexes.mjs",
    "media:audit": "node --conditions=react-server --env-file-if-exists=.env.local scripts/media-audit.mjs",
    "db:catalog:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/catalog-indexes.mjs",
    "db:contact:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/contact-indexes.mjs",
    "db:address:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/address-indexes.mjs",
    "db:cart:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/cart-indexes.mjs",
    "db:delivery:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/delivery-indexes.mjs",
    "db:order:indexes": "node --conditions=react-server --env-file-if-exists=.env.local scripts/order-indexes.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/stylis-plugin-rtl": "^7.3.1",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "file-type": "^22.1.1",
    "jalaali-js": "^2.0.0",
    "leaflet": "1.9.4",
    "mongoose": "9.10.2",
    "mp4box": "^2.5.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stylis": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/stylis": "^4.2.7",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "^5"
  }
}
