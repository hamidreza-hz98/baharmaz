# Local development only; no credentials or production addresses.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Only used with NODE_ENV=test, and restricted to a local instance.
MONGODB_TEST_URI=mongodb://127.0.0.1:27019
MONGODB_TEST_DB_NAME=lamsechi_test_local

# Session lifetime in days, from 1 through 365. Default: 30.
SESSION_DAYS=30
# OTP development configuration. Generate a unique random secret; do not commit it.
APP_ORIGIN=http://localhost:3000
OTP_SECRET=
OTP_EXPIRY_SECONDS=120
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
# Fake SMS is available only in development and logs test codes locally when explicitly enabled.
SMS_PROVIDER=
OTP_DEV_LOG_CODES=false

# Unique random secret (at least 32 UTF-8 bytes) for contact rate-limit identifiers.
CONTACT_RATE_SECRET=

# Optional browser-visible HTTPS XYZ tile template and plain-text attribution.
# If both are empty, OpenStreetMap standard tiles are used.
MAP_TILE_URL=
MAP_ATTRIBUTION=
# Optional server-only HTTPS endpoint compatible with Nominatim reverse JSON (display_name).
GEOCODER_URL=

# Sandbox only. Use an HTTPS callback in deployed environments; localhost HTTP is allowed in development.
AQAYE_MODE=
AQAYE_PIN=
AQAYE_CALLBACK_URL=
